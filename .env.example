# Django
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# FRONTEND_URL is appended to both lists automatically (settings/base.py),
# so it does not need to be repeated here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Single source of truth for every user-facing link (emails, invites, Stripe).
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO

# Database. localhost:5432 is correct for host-based (venv) dev; docker-compose.yml
# overrides this to the in-network 'db' host for containers -- do not change here.
DB_NAME=workroom_db
DB_USERNAME=postgres
DB_PASSWORD=
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/workroom_db

# Redis / Celery. Same localhost-vs-container note as DATABASE_URL above.
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
RATE_LIMIT_ENABLED=True

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Gmail SMTP)
COMPANY_EMAIL=
EMAIL_PASSWORD=
EMAIL_PORT=587

# FastAPI AI service (workroom-ai). localhost:8001 for host-based dev;
# docker-compose.yml overrides this to host.docker.internal:8001 for the
# celery_worker_heavy container.
WORKROOM_AI_SERVICE_URL=http://localhost:8001
WORKROOM_AI_SERVICE_TOKEN=
WORKROOM_AI_SERVICE_TIMEOUT=90


# Dev monitoring UIs (docker-compose only: pgadmin/redisinsight/flower)
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
